---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout
  title="Search"
  description="Search all reports and guides on Janhit Watch."
>
  <section class="hero">
    <h1>Search</h1>
    <p>Find reports and guides by name, topic or keyword.</p>
  </section>

  <div id="search" style="margin-top:8px"></div>

  <p class="legal-note" id="search-dev-note">
    Note: search works on the published (built) site. If you are viewing this
    with <code>npm run dev</code>, run <code>npm run build &amp;&amp; npm run preview</code>
    to test it locally.
  </p>

  <link rel="stylesheet" href="/pagefind/pagefind-ui.css" />
  <script is:inline src="/pagefind/pagefind-ui.js"></script>
  <script is:inline>
    window.addEventListener('DOMContentLoaded', () => {
      if (window.PagefindUI) {
        document.getElementById('search-dev-note')?.remove();
        new window.PagefindUI({ element: '#search', showSubResults: true, showImages: false });
      }
    });
  </script>
</BaseLayout>
