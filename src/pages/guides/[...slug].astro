---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Sources from '../../components/Sources.astro';
import AdSlot from '../../components/AdSlot.astro';
import SupportBox from '../../components/SupportBox.astro';
import { SITE } from '../../consts';

export async function getStaticPaths() {
  const guides = await getCollection('guides', ({ data }) => !data.draft);
  return guides.map((guide) => ({ params: { slug: guide.id }, props: { guide } }));
}

const { guide } = Astro.props;
const d = guide.data;
const { Content } = await render(guide);
const fmt = (date: Date) =>
  date.toLocaleDateString('en-IN', { year: 'numeric', month: 'long', day: 'numeric' });
---
<BaseLayout title={d.title} description={d.description} type="article">
  <article class="article" data-pagefind-body>
    <div class="meta">
      <span>Guide</span>
      <span>{fmt(d.pubDate)}</span>
      {d.updatedDate && <span>Updated {fmt(d.updatedDate)}</span>}
      <span>{d.author ?? SITE.author}</span>
    </div>
    <h1>{d.title}</h1>
    <p style="color:var(--muted);font-size:1.05rem">{d.description}</p>
    <div class="prose"><Content /></div>
    {d.tags.length > 0 && (
      <div class="tags">{d.tags.map((t: string) => <a class="tag" href={`/topics/${t}/`}>#{t}</a>)}</div>
    )}
    {d.sources.length > 0 && <Sources sources={d.sources} />}
    <AdSlot slot="guide-bottom" />
    <SupportBox />
  </article>
</BaseLayout>
