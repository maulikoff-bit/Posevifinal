---
import { ADSENSE_CLIENT } from '../consts';
interface Props {
  slot?: string;
}
const { slot } = Astro.props;
const enabled = Boolean(ADSENSE_CLIENT);
---
{
  enabled ? (
    <ins
      class="adsbygoogle"
      style="display:block"
      data-ad-client={ADSENSE_CLIENT}
      data-ad-slot={slot}
      data-ad-format="auto"
      data-full-width-responsive="true"
    />
    <script is:inline>(adsbygoogle = window.adsbygoogle || []).push({});</script>
  ) : (
    <div class="ad-slot">Ad space (enable AdSense in src/consts.ts)</div>
  )
}
