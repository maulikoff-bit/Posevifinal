---
import { NEWSLETTER } from '../consts';
const show = NEWSLETTER.enabled && NEWSLETTER.action;
---
{
  show && (
    <section class="newsletter">
      <h3>Get new investigations by email</h3>
      <p>No spam. Unsubscribe any time. We never share your address.</p>
      <form action={NEWSLETTER.action} method="post" target="_blank" class="newsletter-form">
        <input
          type="email"
          name={NEWSLETTER.emailField}
          placeholder="you@example.com"
          required
          aria-label="Email address"
        />
        <button type="submit" class="btn">Subscribe</button>
      </form>
    </section>
  )
}
